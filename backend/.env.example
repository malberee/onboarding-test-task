# Тільки тестові ключі Stripe: Dashboard -> Developers -> API keys (у test mode / sandbox)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

PORT=4242

# Звідки дозволені запити (через кому, якщо кілька)
CLIENT_ORIGIN=http://localhost:5173

# Необов'язково. За замовчуванням Stripe сам показує методи, увімкнені в Dashboard.
# Щоб задати явно: PAYMENT_METHOD_TYPES=card,ideal
PAYMENT_METHOD_TYPES=
